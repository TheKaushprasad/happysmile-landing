# Website (Vite) env. Copy to .env.local and fill in.

# Point lead submissions at your local backend (optional — enables the Sarvam
# call + Google Sheet logging). Leave blank to run the site standalone.
VITE_LEAD_ENDPOINT=http://localhost:3001/api/leads
VITE_SARVAM_CAMPAIGN_ID=demo-campaign

# Google Sheet — the Apps Script web-app URL. Written directly from the website
# (Apps Script is always-on, so the sheet fills with no backend running).
VITE_SHEETS_WEBHOOK_URL=

# Supabase (durable store, written directly from the website).
# Settings → API in your Supabase project. The anon key is public-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
