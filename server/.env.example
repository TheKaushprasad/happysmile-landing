# Copy to .env and fill in for live mode. Everything is optional — with no values
# the server runs in DEMO mode (no real Sarvam calls; it logs what it would do).

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Sarvam — the server holds these; the browser never sees them.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_OUTBOUNDS_URL=https://apps.sarvam.ai/api/outbounds
SARVAM_CAMPAIGN_ID=

# Instant outbound call (triggered when someone requests a callback).
# Get these from the Sarvam console.
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=            # your HappySmile agent (app) id
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=     # the telephony connection your number is on
SARVAM_AGENT_NUMBER=      # your Sarvam virtual number (the caller id)

# Where Sarvam POSTs the call outcome (your public webhook URL).
PUBLIC_WEBHOOK_URL=

# Shared secret the webhook checks (set the same value in the Sarvam campaign).
WEBHOOK_SECRET=
