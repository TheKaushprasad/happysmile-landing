# Copy to .env and fill in for live mode. Everything is optional — with no values
# the server runs in DEMO mode (no real Sarvam calls; it logs what it would do).

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Sarvam — the server holds these; the browser never sees them.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CAMPAIGN_ID=

# Shared secret the webhook checks (set the same value in the Sarvam campaign).
WEBHOOK_SECRET=
